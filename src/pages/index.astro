---
import SocialList from "@/components/SocialList.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts, sortMDByDate } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);

const cactusTech: { desc: string; href: string; title: string }[] = [
	{
		desc: "The library for web and native user interfaces.",
		href: "https://react.dev",
		title: "React",
	},
	{
		desc: "Build fast websites, faster.",
		href: "https://astro.build",
		title: "Astro",
	},
	{
		desc: "Rapidly build modern websites without ever leaving your HTML.",
		href: "https://tailwindcss.com",
		title: "Tailwind CSS",
	},
	{
		desc: "An open source component library optimized for fast development, easy maintenance, and accessibility.",
		href: "https://www.radix-ui.com/",
		title: "Radix UI",
	},
	{
		desc: "Beautifully designed components that you can copy and paste into your apps.",
		href: "https://ui.shadcn.com/",
		title: "shadcn/ui",
	},
	{
		desc: "Simple and easy-to-use markup language for HTML content formatting.",
		href: "https://www.radix-ui.com/",
		title: "Markdown",
	},
	{
		desc: "Markdown for the component era.",
		href: "https://mdxjs.com/",
		title: "MDX",
	},
	{
		desc: "Open-source database engineered to advance SQL into a sophisticated graph data model.",
		href: "https://www.edgedb.com",
		title: "Edge|DB",
	},

	{
		desc: "A frontend workshop for building UI components and pages in isolation.",
		href: "https://storybook.js.org/",
		title: "Storybook",
	},
	{
		desc: "A visual testing & review tool that scans every possible UI state to catch visual and functional bugs.",
		href: "https://www.chromatic.com/",
		title: "Chromatic",
	},
	{
		desc: "Reliable end-to-end testing for modern web apps.",
		href: "https://playwright.dev/",
		title: "Playwright",
	},
	{
		desc: "Jest is JavaScript Testing Framework with a focus on simplicity. It works with projects using: TypeScript, Node, React and more!",
		href: "https://jestjs.io/",
		title: "Jest",
	},
	{
		desc: "An open source distributed version control system used for source code management.",
		href: "https://git-scm.com",
		title: "Git",
	},
	{
		desc: "A library designed for writing css styles with JavaScript.",
		href: "https://emotion.sh/docs/introduction/",
		title: "Emotion",
	},
	{
		desc: "Generating png Open Graph images for blog posts.",
		href: "https://react.dev",
		title: "Satori",
	},
	{
		desc: "A fully static search library.",
		href: "https://pagefind.app/",
		title: "Pagefind",
	},
	{
		desc: "An easy to use Icon component for Astro.",
		href: "https://github.com/natemoo-re/astro-icon#readme",
		title: "Astro Icon",
	},
	{
		desc: "Highly customisable source code & syntax highlighter.",
		href: "https://expressive-code.com/",
		title: "Expressive Code",
	},
	{
		desc: "A helper that facilitates the design and management of component's diverse contexts.",
		href: "https://cva.style/",
		title: "Class Variance Authority",
	},
	{
		desc: "Merge Tailwind CSS classes without style conflicts.",
		href: "https://github.com/dcastil/tailwind-merge",
		title: "Tailwind Merge",
	},
];
---

<PageLayout meta={{ title: "Home" }}>
	<section>
		<h1 class="title mb-6">Hello Internet People!</h1>
		<p class="mb-4">
			Hi, I’m Stew, a Melbourne-based consultant.
			I specialise in Communications Arts and Technology projects. 
			Lately I'm working with Astro JS.
		</p>
		<SocialList />
	</section>
	<section aria-label="Blog post list" class="mt-16">
		<h2 class="title mb-4 text-xl">Posts</h2>
		<ul class="space-y-4">
			{
				allPostsByDate.map((p) => (
					<li class="grid gap-2 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
	</section>
	<section class="mt-16">
		<h2 class="title mb-4 text-xl">A selection of technologies regularly used...</h2>
		<dl class="space-y-4">
			{
				cactusTech.map(({ desc, href, title }) => (
					<div class="flex flex-col gap-2 sm:flex-row">
						<dt>
							<span class="flex">
								<a class="cactus-link" href={href} rel="noopener noreferrer" target="_blank">
									{title}
								</a>
								:
							</span>
						</dt>
						<dd>{desc}</dd>
					</div>
				))
			}
		</dl>
	</section>
</PageLayout>
